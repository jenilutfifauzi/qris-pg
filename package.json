{
  "name": "qris-pg",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal QRIS payment gateway kit for Cloudflare Workers (static→dynamic + GoBiz mutasi + WebUI)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute qris-pg --local --file=./migrations/0001_init.sql",
    "db:remote": "wrangler d1 execute qris-pg --remote --file=./migrations/0001_init.sql",
    "test": "node --test test/*.test.js",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "wrangler": "^4.28.0"
  }
}
