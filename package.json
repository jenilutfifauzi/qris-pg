{
  "name": "qris-pg",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal QRIS payment gateway kit for Cloudflare Workers (static→dynamic + GoBiz mutasi + WebUI)",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply qris-pg --local",
    "db:remote": "wrangler d1 migrations apply qris-pg --remote",
    "test": "node --test test/*.test.js",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "wrangler": "^4.28.0"
  }
}
