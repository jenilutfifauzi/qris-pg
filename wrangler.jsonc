{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qris-pg",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*"]
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  // database_id diisi dari: npx wrangler d1 create qris-pg
  // (UUID binding publik — BUKAN secret. Secrets: wrangler secret put API_KEY)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qris-pg",
      "database_id": "e8377964-b5dd-4636-88e6-6454fed67a81",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "DEFAULT_EXPIRE_MIN": "30"
  }
}
